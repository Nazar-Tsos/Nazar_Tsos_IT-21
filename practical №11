<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Замовлення товару</title>
</head>
<body>

<?php

$products = [
    "Ноутбук" => 30000,
    "Мишка" => 500,
    "Клавіатура" => 1200
];

$errors = [];

if ($_SERVER["REQUEST_METHOD"] == "POST") {

    $name = htmlspecialchars(trim($_POST["name"]));
    $email = htmlspecialchars(trim($_POST["email"]));
    $product = $_POST["product"];
    $quantity = filter_input(INPUT_POST, "quantity", FILTER_VALIDATE_INT);

    if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
        $errors[] = "Некоректний email.";
    }

    if ($quantity < 1 || $quantity > 100) {
        $errors[] = "Кількість повинна бути від 1 до 100.";
    }

    if (empty($errors)) {

        $total = $products[$product] * $quantity;

        echo "<h3>Підсумок замовлення</h3>";
        echo "Покупець: $name<br>";
        echo "Email: " . htmlspecialchars($email) . "<br>";
        echo "Товар: " . htmlspecialchars($product) . "<br>";
        echo "Кількість: $quantity<br>";
        echo "Сума: $total грн";

        exit;
    }
}

foreach ($errors as $error) {
    echo "<p style='color:red;'>$error</p>";
}
?>

<form method="post">

    Ім'я покупця:<br>
    <input type="text" name="name" required><br><br>

    Email:<br>
    <input type="email" name="email" required><br><br>

    Товар:<br>
    <select name="product">
        <option>Ноутбук</option>
        <option>Мишка</option>
        <option>Клавіатура</option>
    </select><br><br>

    Кількість:<br>
    <input type="number" name="quantity" required><br><br>

    <button type="submit">Замовити</button>

</form>

</body>
</html>
